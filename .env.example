# Copie este arquivo para .env se quiser rodar em outra porta.
# Sem preencher a seção InfoSimples abaixo, o site funciona 100% grátis
# (modo de redirecionamento pro portal oficial do Detran-GO).

PORT=3000

# --- InfoSimples — DETRAN/GO Débitos (opcional, pago) -----------------------
# Só preencha quando for ativar a consulta real. As 5 variáveis abaixo são
# TODAS obrigatórias pra ativar — faltando qualquer uma, o site continua no
# modo gratuito automaticamente. Confirme os nomes exatos de parâmetro e a
# URL do endpoint no painel da sua conta (https://api.infosimples.com/)
# antes de usar em produção — ver comentários em datasource/consultaVeiculo.js.
#
# INFOSIMPLES_TOKEN=            # chave da sua conta InfoSimples
# INFOSIMPLES_LOGIN_CPF=        # CPF do despachante credenciado no Detran-GO
# INFOSIMPLES_LOGIN_SENHA=      # senha do despachante no sistema do Detran-GO
# INFOSIMPLES_PKCS12_CERT_PATH=./certs/despachante.pfx   # NUNCA commitar esse arquivo
# INFOSIMPLES_PKCS12_PASS=      # senha do certificado .pfx
# INFOSIMPLES_API_URL=https://api.infosimples.com/api/v2/consultas/detran/go/debitos
