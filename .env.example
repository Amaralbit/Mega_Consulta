# Copie este arquivo para .env e preencha os valores reais.
# .env nunca deve ser commitado (já está no .gitignore).

# obrigatório em produção — string aleatória longa (ex.: `openssl rand -hex 32`)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# quantos créditos grátis o usuário ganha ao criar a conta (teste do produto)
FREE_TRIAL_CREDITS=3

# URL pública da aplicação (usada nos redirects de volta do Stripe Checkout)
APP_URL=http://localhost:3000

# --- Stripe (opcional — sem isso, a compra de créditos fica desabilitada) ---
# chaves de TESTE em https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# gerado por `stripe listen --forward-to localhost:3000/api/billing/webhook`
# (Stripe CLI) durante o desenvolvimento local
STRIPE_WEBHOOK_SECRET=whsec_...

PORT=3000
